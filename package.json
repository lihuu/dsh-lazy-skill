{
  "name": "dsh-lazy-skill",
  "version": "0.1.0",
  "description": "Lazy-load skill bundles for DeepSeek Harness: a bundle box holds a root skill and sub-skills, loaded by metadata (`loadSubskills`) or by model decision from body text.",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "boxes",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs",
    "prepare": "npm run build"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "skill",
    "plugin"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lihuu/dsh-lazy-skill.git"
  },
  "homepage": "https://github.com/lihuu/dsh-lazy-skill#readme",
  "bugs": {
    "url": "https://github.com/lihuu/dsh-lazy-skill/issues"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-skill": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "yaml": "^2.4.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-skill": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2",
    "@types/node": "^22.20.0",
    "typescript": "^6.0.3"
  }
}